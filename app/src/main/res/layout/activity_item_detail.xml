<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/cf_background"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ItemDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.CampusFind.Toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_item_detail"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/detail_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_detail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@id/action_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CampusFind.Card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/detail_image_height"
                app:cardCornerRadius="@dimen/radius_large">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_image_placeholder">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vp_photos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tv_photo_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="@dimen/space_12"
                        android:background="@drawable/bg_scrim_pill"
                        android:drawablePadding="@dimen/space_4"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/space_8"
                        android:paddingVertical="2dp"
                        android:textColor="@color/cf_on_dark"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/ic_camera"
                        app:drawableTint="@color/cf_on_dark"
                        tools:text="1/3" />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tab_photo_dots"
                        style="@style/Widget.CampusFind.TabLayout.Dots"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="@dimen/space_8"
                        android:background="@android:color/transparent" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="72dp"
                    android:textAppearance="@style/TextAppearance.CampusFind.Title"
                    tools:text="Black Leather Wallet" />

                <TextView
                    android:id="@+id/tv_posted_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:textAppearance="@style/TextAppearance.CampusFind.Caption"
                    tools:text="2h ago" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_status"
                    style="@style/Widget.CampusFind.Badge.Found"
                    android:drawablePadding="@dimen/space_4"
                    app:drawableStartCompat="@drawable/ic_dot"
                    app:drawableTint="@color/cf_found_text"
                    tools:text="Found" />

                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/cf_lavender_100"
                    android:drawablePadding="@dimen/space_4"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.CampusFind.Chip"
                    android:textColor="@color/cf_navy_700"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_description"
                    app:drawableTint="@color/cf_navy_700"
                    tools:text="Wallet &amp; Cards" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_owner"
                style="@style/Widget.CampusFind.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardCornerRadius="@dimen/radius_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_poster_avatar"
                        android:layout_width="@dimen/avatar_small"
                        android:layout_height="@dimen/avatar_small"
                        android:background="@color/cf_lavender_100"
                        android:contentDescription="@string/cd_profile_photo"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CampusFind.Circle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_poster_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.CampusFind.TitleSmall"
                            android:textSize="15sp"
                            app:drawableEndCompat="@drawable/ic_verified"
                            app:drawableTint="@color/cf_navy_700"
                            tools:text="Dimas Area" />

                        <TextView
                            android:id="@+id/tv_poster_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.CampusFind.Caption"
                            tools:text="BINUS Kemanggisan · Comp Science" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_poster_verified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/cf_found_soft"
                        android:drawablePadding="@dimen/space_4"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/space_8"
                        android:paddingVertical="@dimen/space_4"
                        android:text="@string/detail_verified"
                        android:textColor="@color/cf_found_text"
                        android:textSize="11sp"
                        app:drawableStartCompat="@drawable/ic_shield"
                        app:drawableTint="@color/cf_found_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Deskripsi barang: warna, bentuk, jenis, merek, ciri khusus -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CampusFind.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardCornerRadius="@dimen/radius_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_description"
                        android:textAppearance="@style/TextAppearance.CampusFind.Overline" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CampusFind.Body"
                        tools:text="Found on study table near window, 3rd floor. Student ID card inside." />

                    <LinearLayout
                        android:id="@+id/row_attr_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:text="@string/attr_color"
                            android:textAppearance="@style/TextAppearance.CampusFind.BodySmall" />

                        <TextView
                            android:id="@+id/tv_attr_color"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.CampusFind.Label"
                            tools:text="Black" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/row_attr_shape"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:text="@string/attr_shape"
                            android:textAppearance="@style/TextAppearance.CampusFind.BodySmall" />

                        <TextView
                            android:id="@+id/tv_attr_shape"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.CampusFind.Label"
                            tools:text="Rectangle" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/row_attr_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:text="@string/attr_type"
                            android:textAppearance="@style/TextAppearance.CampusFind.BodySmall" />

                        <TextView
                            android:id="@+id/tv_attr_type"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.CampusFind.Label"
                            tools:text="Bifold wallet" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/row_attr_brand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:text="@string/attr_brand"
                            android:textAppearance="@style/TextAppearance.CampusFind.BodySmall" />

                        <TextView
                            android:id="@+id/tv_attr_brand"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.CampusFind.Label"
                            tools:text="-" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/row_attr_marks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:text="@string/attr_marks"
                            android:textAppearance="@style/TextAppearance.CampusFind.BodySmall" />

                        <TextView
                            android:id="@+id/tv_attr_marks"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.CampusFind.Label"
                            tools:text="Small scratch on the corner" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status journey: Lost -> Found -> Returned (warnai lingkaran lewat kode sesuai status) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CampusFind.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardCornerRadius="@dimen/radius_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_journey"
                            android:textAppearance="@style/TextAppearance.CampusFind.Overline" />

                        <TextView
                            android:id="@+id/tv_journey_step"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:textAppearance="@style/TextAppearance.CampusFind.Label"
                            android:textColor="@color/cf_navy_700"
                            android:textSize="12sp"
                            tools:text="Step 2 of 3" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/journey_lost"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/cf_lost_bg"
                                android:importantForAccessibility="no"
                                android:padding="9dp"
                                android:src="@drawable/ic_check"
                                app:tint="@color/cf_lost_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/status_lost"
                                android:textAppearance="@style/TextAppearance.CampusFind.Caption" />
                        </LinearLayout>

                        <View
                            android:id="@+id/journey_line_1"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginHorizontal="@dimen/space_4"
                            android:layout_marginTop="16dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="@color/cf_found_bg" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/journey_found"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/cf_found_bg"
                                android:importantForAccessibility="no"
                                android:padding="9dp"
                                android:src="@drawable/ic_search"
                                app:tint="@color/cf_found_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/status_found"
                                android:textAppearance="@style/TextAppearance.CampusFind.Caption" />
                        </LinearLayout>

                        <View
                            android:id="@+id/journey_line_2"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginHorizontal="@dimen/space_4"
                            android:layout_marginTop="16dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="@color/cf_lavender_200" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/journey_returned"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/cf_lavender_100"
                                android:importantForAccessibility="no"
                                android:padding="9dp"
                                android:src="@drawable/ic_history"
                                app:tint="@color/cf_ink_muted" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/status_returned"
                                android:textAppearance="@style/TextAppearance.CampusFind.Caption" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lokasi (OPSIONAL: sembunyikan card ini jika pemosting tidak mengisi lokasi) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_location"
                style="@style/Widget.CampusFind.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardCornerRadius="@dimen/radius_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_rounded_12"
                        android:backgroundTint="@color/cf_blue_100"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/cf_navy_700" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.CampusFind.TitleSmall"
                            android:textSize="14sp"
                            tools:text="Library 3rd Floor, Building B" />

                        <TextView
                            android:id="@+id/tv_location_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.CampusFind.Caption"
                            app:drawableStartCompat="@drawable/ic_schedule"
                            app:drawableTint="@color/cf_ink_muted"
                            tools:text="Today, 14:15 WIB · Shelf A-14" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_map"
                        style="@style/Widget.CampusFind.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="@string/detail_map"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconSize="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Aksi bawah. Pengunjung: Chat + This is Mine (Found) / I Found This (Lost). Pemilik post: tombol Mark as Returned. -->
    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/cf_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/group_visitor_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chat"
                    style="@style/Widget.CampusFind.Button.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_12"
                    android:text="@string/detail_chat"
                    app:icon="@drawable/ic_chat"
                    app:iconGravity="textStart" />

                <!-- Found: "This is Mine"  |  Lost: "I Found This" (label diganti dari kode) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_claim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detail_this_is_mine"
                    app:icon="@drawable/ic_verified" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_claim_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:drawablePadding="@dimen/space_4"
                android:gravity="center"
                android:text="@string/detail_claim_note"
                android:textAppearance="@style/TextAppearance.CampusFind.Caption"
                app:drawableStartCompat="@drawable/ic_shield"
                app:drawableTint="@color/cf_ink_muted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mark_returned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_mark_returned"
            android:visibility="gone"
            app:icon="@drawable/ic_check_circle"
            tools:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>