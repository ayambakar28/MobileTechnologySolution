<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".HomeFragment">
        <include
            android:id="@+id/header"
            layout="@layout/layout_app_header" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_32">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding">

                <!-- Sapaan + lokasi kampus + lonceng notifikasi -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_user_avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/cf_lavender_100"
                        android:contentDescription="@string/cd_profile_photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        app:contentPadding="@dimen/space_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CampusFind.Circle"
                        app:tint="@color/cf_navy_700" />

                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:textAppearance="@style/TextAppearance.CampusFind.Title"
                        app:layout_constraintEnd_toStartOf="@id/notif_container"
                        app:layout_constraintStart_toEndOf="@id/iv_user_avatar"
                        app:layout_constraintTop_toTopOf="@id/iv_user_avatar"
                        tools:text="Hi, Rina 👋" />

                    <TextView
                        android:id="@+id/tv_user_campus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:drawablePadding="@dimen/space_4"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.CampusFind.BodySmall"
                        app:drawableStartCompat="@drawable/ic_location"
                        app:drawableTint="@color/cf_navy_700"
                        app:layout_constraintEnd_toStartOf="@id/notif_container"
                        app:layout_constraintStart_toEndOf="@id/iv_user_avatar"
                        app:layout_constraintTop_toBottomOf="@id/tv_greeting"
                        tools:text="Kemanggisan Campus" />

                    <FrameLayout
                        android:id="@+id/notif_container"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageButton
                            android:id="@+id/btn_notifications"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle"
                            android:contentDescription="@string/cd_notifications"
                            android:elevation="2dp"
                            android:src="@drawable/ic_notifications"
                            app:tint="@color/cf_navy_900" />

                        <!-- Sembunyikan (gone) jika tidak ada notifikasi belum dibaca -->
                        <TextView
                            android:id="@+id/tv_notif_badge"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/cf_lost_bg"
                            android:elevation="4dp"
                            android:gravity="center"
                            android:textColor="@color/cf_lost_text"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="3" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Search bar: hanya pintasan, ketuk -> buka tab Search -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_search"
                    style="@style/Widget.CampusFind.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_8">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_search"
                            app:tint="@color/cf_ink_muted" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:text="@string/home_search_hint"
                            android:textAppearance="@style/TextAppearance.CampusFind.Body"
                            android:textColor="@color/cf_hint" />

                        <ImageButton
                            android:id="@+id/btn_filter"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_rounded_12"
                            android:backgroundTint="@color/cf_lavender_100"
                            android:contentDescription="@string/cd_filter"
                            android:src="@drawable/ic_tune"
                            app:tint="@color/cf_navy_700" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Filter status cepat -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cg_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/space_8"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_all"
                            style="@style/Widget.CampusFind.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/status_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_lost"
                            style="@style/Widget.CampusFind.Chip.Lost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_lost" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_found"
                            style="@style/Widget.CampusFind.Chip.Found"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_found" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_returned"
                            style="@style/Widget.CampusFind.Chip.Returned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_returned" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_report" />

                <include
                    android:id="@+id/empty_state"
                    layout="@layout/layout_empty_state"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_see_all"
                    style="@style/Widget.CampusFind.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="@dimen/space_8"
                    android:paddingHorizontal="@dimen/space_20"
                    android:text="@string/home_see_all"
                    android:textColor="@color/cf_navy_900"
                    app:backgroundTint="@color/cf_lavender_100"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconSize="18dp"
                    app:iconTint="@color/cf_navy_900"
                    app:strokeColor="@color/cf_divider"
                    app:strokeWidth="1dp" />

                <!-- Banner statistik -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CampusFind.Card.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:cardBackgroundColor="@color/cf_banner_mint">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_12">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/cf_found_bg"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_check"
                            app:tint="@color/cf_found_text" />

                        <TextView
                            android:id="@+id/tv_returned_stat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.CampusFind.Label"
                            android:textColor="@color/cf_found_text"
                            tools:text="128 items returned this semester at BINUS" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>